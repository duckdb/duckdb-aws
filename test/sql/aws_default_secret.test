# name: test/sql/aws_default_secret.test
# description: the implicit default S3 secret, resolved lazily from the default credential chain, loses to any explicit secret
# group: [sql]

require aws

require httpfs

# the aws_default storage is registered on load: under autoloading, 'require' alone does not load the extension
statement ok
LOAD aws;

statement ok
SET allow_persistent_secrets=false;

# the environment can configure S3 through these settings (DUCKDB_S3_ENDPOINT, AWS_ACCESS_KEY_ID, ...)
statement ok
SET s3_endpoint='';

statement ok
SET s3_access_key_id='';

statement ok
SET s3_secret_access_key='';

statement ok
SET s3_session_token='';

# listed before they are used, without resolving the credential chain
query IIII
SELECT name, type, provider, storage FROM duckdb_secrets() WHERE storage = 'aws_default' ORDER BY name;
----
__aws_default	aws	lazy	aws_default
__aws_default_s3	s3	lazy	aws_default

# the first lookup resolves it to the credentials the chain finds, or to no credentials
query II
SELECT name, storage FROM which_secret('s3://bucket/file.csv', 's3');
----
__aws_default_s3	aws_default

# both are views of the same identity
query I
SELECT count(DISTINCT provider) = 1 AND bool_and(provider IN ('credential_chain', 'none'))
FROM duckdb_secrets() WHERE storage = 'aws_default';
----
true

# the AWS identity, as used by RDS and Redshift
query I
SELECT name FROM which_secret('', 'aws');
----
__aws_default

# it carries the identity and region only, so the endpoint keeps coming from the settings
query I
SELECT secret_string NOT LIKE '%endpoint=%' FROM duckdb_secrets() WHERE name = '__aws_default_s3';
----
true

# S3 configured through the settings is not overridden by it
statement ok
SET s3_endpoint='localhost:9000';

query I
SELECT count(*) FROM which_secret('s3://bucket/file.csv', 's3');
----
0

statement ok
SET s3_endpoint='';

statement ok
SET s3_access_key_id='settings_key';

query I
SELECT count(*) FROM which_secret('s3://bucket/file.csv', 's3');
----
0

statement ok
SET s3_access_key_id='';

# it only covers S3 paths
query I
SELECT count(*) FROM which_secret('gcs://bucket/file.csv', 'gcs');
----
0

# an explicit secret wins, even one with a catch-all scope
statement ok
CREATE SECRET explicit (TYPE s3, KEY_ID 'a', SECRET 'b', SCOPE '');

query I
SELECT name FROM which_secret('s3://bucket/file.csv', 's3');
----
explicit

statement ok
DROP SECRET explicit;

# PROVIDER none overrides it without credentials, so requests are sent unsigned
statement ok
CREATE SECRET anonymous (TYPE s3, PROVIDER none);

query I
SELECT name FROM which_secret('s3://bucket/file.csv', 's3');
----
anonymous

query I
SELECT secret_string FROM duckdb_secrets(redact=false) WHERE name = 'anonymous';
----
<REGEX>:^name=anonymous;type=s3;provider=none;serializable=true;scope=s3://,s3n://,s3a://;$

statement ok
DROP SECRET anonymous;

# the default secret cannot be created or replaced by hand
statement error
CREATE SECRET other IN aws_default (TYPE s3, PROVIDER none);
----
Secrets cannot be created in the 'aws_default' secret storage

# switched off, no secret matches
statement ok
SET aws_default_credentials=false;

query I
SELECT count(*) FROM which_secret('s3://bucket/file.csv', 's3');
----
0

statement ok
RESET aws_default_credentials;

# dropping one drops both for the lifetime of the database
statement ok
DROP SECRET __aws_default_s3;

query I
SELECT count(*) FROM duckdb_secrets() WHERE storage = 'aws_default';
----
0

query I
SELECT count(*) FROM which_secret('', 'aws');
----
0

query I
SELECT count(*) FROM which_secret('s3://bucket/file.csv', 's3');
----
0
