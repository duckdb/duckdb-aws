# name: test/sql/aws_secret_endpoints.test
# description: read and write through S3 endpoints resolved from AWS config
# group: [sql]

require aws

require httpfs

require-env S3_TEST_SERVER_AVAILABLE 1

require-env DUCKDB_S3_ENDPOINT

require-env DUCKDB_S3_USE_SSL

require-env AWS_CONFIG_FILE

require-env AWS_SHARED_CREDENTIALS_FILE

# HTTP errors must fail rather than being ignored by the test runner.
set ignore_error_messages

statement ok
SET allow_persistent_secrets=false

# Prevent DUCKDB_S3_ENDPOINT / DUCKDB_S3_USE_SSL from supplying fallback settings.
# The endpoint URL in AWS config must supply the host, port and scheme.
statement ok
SET s3_endpoint='';

statement ok
SET s3_use_ssl=true;

statement ok
CREATE SECRET service_endpoint (
    TYPE s3,
    PROVIDER credential_chain,
    CHAIN 'config',
    PROFILE 's3-endpoint-services',
    SCOPE 's3://test-bucket/aws_secret_endpoints/services/',
    URL_STYLE 'path'
);

# Verify config resolution before I/O, so a fallback endpoint cannot hide a bug.
query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) =
       CASE WHEN '{DUCKDB_S3_USE_SSL}' = 'true' THEN 'https://' ELSE 'http://' END || '{DUCKDB_S3_ENDPOINT}/'
FROM duckdb_secrets() WHERE name='service_endpoint';
----
true

# No SQL ENDPOINT or USE_SSL is supplied; the config URL must be sufficient.
statement ok
COPY (SELECT 42 AS value) TO 's3://test-bucket/aws_secret_endpoints/services/endpoint.csv';

query I
SELECT value FROM read_csv('s3://test-bucket/aws_secret_endpoints/services/endpoint.csv');
----
42

statement ok
CREATE SECRET global_endpoint (
    TYPE s3,
    PROVIDER credential_chain,
    CHAIN 'config',
    PROFILE 's3-endpoint-global',
    SCOPE 's3://test-bucket/aws_secret_endpoints/global/',
    URL_STYLE 'path'
);

query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) =
       CASE WHEN '{DUCKDB_S3_USE_SSL}' = 'true' THEN 'https://' ELSE 'http://' END || '{DUCKDB_S3_ENDPOINT}/'
FROM duckdb_secrets() WHERE name='global_endpoint';
----
true

statement ok
COPY (SELECT 123 AS value) TO 's3://test-bucket/aws_secret_endpoints/global/endpoint.csv';

query I
SELECT value FROM read_csv('s3://test-bucket/aws_secret_endpoints/global/endpoint.csv');
----
123
