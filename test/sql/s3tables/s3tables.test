# name: test/sql/s3tables/s3tables.test
# group: [s3tables]

require-env S3TABLES_TEST_AVAILABLE 1

require-env AWS_S3TABLES_REGION

require-env AWS_S3TABLES_TABLE_BUCKET_ARN

require-env AWS_S3TABLES_NAMESPACE

require-env AWS_S3TABLES_TABLE

require-env S3TABLES_AWS_CREDENTIAL_CHAIN

require httpfs

require parquet

require avro

require iceberg

require aws

require json

statement ok
SET allow_persistent_secrets=false

statement ok
CREATE TEMPORARY SECRET s3tables_test_credentials (
    TYPE s3,
    PROVIDER credential_chain,
    CHAIN '{S3TABLES_AWS_CREDENTIAL_CHAIN}',
    REGION '{AWS_S3TABLES_REGION}'
);

statement ok
ATTACH '{AWS_S3TABLES_TABLE_BUCKET_ARN}' AS db (
    SECRET s3tables_test_credentials
);

query III
SELECT * FROM db."{AWS_S3TABLES_NAMESPACE}"."{AWS_S3TABLES_TABLE}"
ORDER BY sale_date, product, quantity;
----
2020-07-21	SHOES	21
2020-07-22	JACKET	3
2020-07-24	SOCKS	87

statement ok
DETACH db

statement ok
DROP SECRET s3tables_test_credentials
