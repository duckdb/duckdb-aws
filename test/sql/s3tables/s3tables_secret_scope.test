# name: test/sql/s3tables/s3tables_secret_scope.test
# description: unnamed AWS secret resolution goes by scope, so scoped s3 secrets never make account-level calls ambiguous
# group: [s3tables]

require no_extension_autoloading "EXPECTED: Test relies on explicit INSTALL and LOAD"

require httpfs

require aws

# No ambient credentials: the recipe callbacks run on their own connections, so the lazy default
# secrets are disabled globally. Every unnamed secret lookup then fails deterministically, before
# any network call.
statement ok
SET GLOBAL aws_default_credentials=false;

# Two secrets scoped to specific warehouses, as a ducklake + iceberg-rest setup leaves behind.
statement ok
CREATE SECRET ducklake_warehouse (TYPE s3, KEY_ID 'AKIAIOSFODNN7EXAMPLE', SECRET 'wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY', SCOPE 's3://container-ducklake-warehouse');

statement ok
CREATE SECRET iceberg_warehouse (TYPE s3, KEY_ID 'AKIAIOSFODNN7EXAMPLE', SECRET 'wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY', SCOPE 's3://container-iceberg-rest-warehouse');

# Neither scope covers an account-level call, so resolution finds nothing — the error must not be
# the old count-based 'Found 2 secrets of type "s3"'.
statement error
SELECT * FROM s3tables_table_buckets('eu-central-1');
----
<REGEX>:.*No AWS credentials found.*

statement error
SHOW ALL EXTERNAL RESOURCES;
----
<REGEX>:.*No AWS credentials found.*

# An unscoped secret is what account-level calls pick, however many scoped ones exist — proven by
# the error naming it, thrown before any network call because it holds no keys.
statement ok
CREATE SECRET unscoped (TYPE s3, PROVIDER none);

statement error
SELECT * FROM s3tables_table_buckets('eu-central-1');
----
<REGEX>:.*Secret "unscoped" holds no AWS credentials.*

# An aws-type secret outranks every s3 one for these calls.
statement ok
CREATE SECRET identity (TYPE aws, PROVIDER none);

statement error
SELECT * FROM s3tables_table_buckets('eu-central-1');
----
<REGEX>:.*Secret "identity" holds no AWS credentials.*
