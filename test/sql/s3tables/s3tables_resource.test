# name: test/sql/s3tables/s3tables_resource.test
# description: the aws:s3tables:table-bucket external-resource type and its callbacks
# group: [s3tables]

require no_extension_autoloading "EXPECTED: Test relies on explicit INSTALL and LOAD"

require httpfs

require aws

# Every AWS call below is meant to fail. Pin the identity to a bogus static key so this holds even
# where the environment carries real credentials: the provisioning statement further down would
# otherwise create a real table bucket.
statement ok
CREATE SECRET bogus (TYPE s3, KEY_ID 'AKIAIOSFODNN7EXAMPLE', SECRET 'wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY', REGION 'eu-central-1');

# The type is registered from C++ (origin 'extension'), so LOAD aws is all a user needs.
query IIIIII
SELECT name, kind, origin, create_function, status_function, list_function
FROM duckdb_external_resource_types() WHERE name = 'aws:s3tables:table-bucket';
----
aws:s3tables:table-bucket	catalog	extension	__aws__s3tables__table_bucket__create	__aws__s3tables__table_bucket__status	__aws__s3tables__table_bucket__list

query I
SELECT destroy_function FROM duckdb_external_resource_types() WHERE name = 'aws:s3tables:table-bucket';
----
__aws__s3tables__table_bucket__destroy

# The handle is a single 'arn' key: the ARN already encodes partition, region, account and name,
# so nothing can drift out of sync with what the list callback emits. A handle without it is
# refused by name, before any AWS call.
statement error
SELECT * FROM __aws__s3tables__table_bucket__status(MAP {'region': 'eu-central-1'});
----
handle is missing 'arn'

statement error
SELECT * FROM __aws__s3tables__table_bucket__destroy(MAP {'name': 'x'});
----
handle is missing 'arn'

# The status callback validates the ARN it is handed — this is the adoption path, since
# REGISTER EXTERNAL RESOURCE skips create and resolves a user-supplied handle through here.
statement error
SELECT * FROM __aws__s3tables__table_bucket__status(MAP {'arn': 'not-an-arn'});
----
expected a table bucket ARN

# Provisioning through the framework reaches the create callback and, from there, the AWS call,
# which the bogus key fails: the error names the callback rather than anything earlier in the chain.
statement error
CREATE EXTERNAL RESOURCE 'aws:s3tables:table-bucket' AS bucket_x (REGION 'eu-central-1');
----
<REGEX>:.*__aws__s3tables__table_bucket__create.*

# Adoption of an existing bucket goes through status, not create.
statement error
REGISTER EXTERNAL RESOURCE 'aws:s3tables:table-bucket' AS bucket_y
FROM MAP {'arn': 'arn:aws:s3tables:eu-central-1:123456789012:bucket/nope'};
----
<REGEX>:.*__aws__s3tables__table_bucket__status.*

# A SQL macro can shadow the real create function and return an empty ARN without calling AWS.
# Keep the recovery advice conditional: a lost response can also leave an existing bucket without a handle.
# The callback uses a separate connection, so the stand-in must not be temporary.
statement ok
CREATE MACRO s3tables_create_table_bucket(name, region := NULL, tags := NULL) AS TABLE
SELECT MAP {'arn': ''} AS handle, '' AS arn, name, region;

statement error
SELECT * FROM __aws__s3tables__table_bucket__create(MAP {'name': 'armless', 'region': 'eu-central-1'});
----
<REGEX>:.*s3tables_create_table_bucket returned an empty ARN for 'armless'\. If an AWS create request was sent, the bucket may already exist;.*

# The delete substitute errors on cascade=true even for an empty bucket, so a teardown that
# cascades cannot pass by luck; the tags substitute reports a matching tag, so a teardown that
# cascades on the tag errors the same way. A failed delete must leave the resource registered.
statement ok
CREATE TABLE bucket_contents (arn VARCHAR);
INSERT INTO bucket_contents VALUES
    ('arn:aws:s3tables:eu-central-1:123456789012:bucket/owned'),
    ('arn:aws:s3tables:eu-central-1:123456789012:bucket/adopted');

statement ok
CREATE OR REPLACE MACRO s3tables_create_table_bucket(name, region := NULL, tags := NULL) AS TABLE
SELECT MAP {'arn': 'arn:aws:s3tables:' || region || ':123456789012:bucket/' || name} AS handle;

statement ok
CREATE MACRO s3tables_get_table_bucket(bucket_arn) AS TABLE
SELECT bucket_arn AS arn;

statement ok
CREATE MACRO s3tables_table_bucket_tags(bucket_arn) AS TABLE
SELECT 'duckdb-external-resource-type' AS key, 'aws:s3tables:table-bucket' AS value;

statement ok
CREATE MACRO s3tables_delete_table_bucket(handle, cascade := false) AS TABLE
SELECT CASE
    WHEN cascade THEN error('implicit cascade requested')
    WHEN EXISTS (SELECT 1 FROM bucket_contents WHERE arn = handle['arn']) THEN error('ConflictException: bucket is not empty')
    ELSE 'deleted'
END AS status;

statement ok
CREATE EXTERNAL RESOURCE 'aws:s3tables:table-bucket' AS owned (NAME 'owned', REGION 'eu-central-1');

statement ok
REGISTER EXTERNAL RESOURCE 'aws:s3tables:table-bucket' AS adopted
FROM MAP {'arn': 'arn:aws:s3tables:eu-central-1:123456789012:bucket/adopted'};

statement error
DESTROY EXTERNAL RESOURCE owned;
----
bucket is not empty

statement error
DESTROY EXTERNAL RESOURCE adopted;
----
bucket is not empty

query I
SELECT count(*) FROM duckdb_external_resources() WHERE name IN ('owned', 'adopted');
----
2

statement ok
REGISTER EXTERNAL RESOURCE 'aws:s3tables:table-bucket' AS empty_adopted
FROM MAP {'arn': 'arn:aws:s3tables:eu-central-1:123456789012:bucket/empty'};

statement ok
DESTROY EXTERNAL RESOURCE empty_adopted;

query I
SELECT count(*) FROM duckdb_external_resources() WHERE name = 'empty_adopted';
----
0

statement ok
DELETE FROM bucket_contents;

statement ok
DESTROY EXTERNAL RESOURCE owned;

statement ok
DESTROY EXTERNAL RESOURCE adopted;

query I
SELECT count(*) FROM duckdb_external_resources() WHERE name IN ('owned', 'adopted');
----
0
