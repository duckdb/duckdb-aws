# name: test/sql/aws_secret_server_side_encryption.test
# description: KMS_KEY_ID and SSE_C_KEY on credential_chain secrets
# group: [sql]

require aws

require httpfs

# VALIDATION 'none' with explicit keys, so no credentials have to be resolved
statement ok
CREATE SECRET ssec (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    KEY_ID 'AKIAEXAMPLE',
    SECRET 'example-secret',
    REGION 'us-east-1',
    SSE_C_KEY 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=',
    SCOPE 's3://ssec-bucket/'
);

# The key is stored as given
query I
SELECT secret_string LIKE '%sse_c_key=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=%'
FROM duckdb_secrets(redact=false) WHERE name = 'ssec';
----
true

# ...and redacted in the default listing
query II
SELECT secret_string LIKE '%sse_c_key=redacted%', secret_string LIKE '%AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=%'
FROM duckdb_secrets() WHERE name = 'ssec';
----
true	false

# With REFRESH 'auto', refresh_info holds a copy of every option, so it is redacted as a whole
statement ok
CREATE SECRET ssec_refresh (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    KEY_ID 'AKIAEXAMPLE',
    SECRET 'example-secret',
    REGION 'us-east-1',
    REFRESH 'auto',
    SSE_C_KEY 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=',
    SCOPE 's3://ssec-refresh-bucket/'
);

query III
SELECT secret_string LIKE '%refresh_info=redacted%', secret_string LIKE '%sse_c_key=redacted%',
       secret_string LIKE '%AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=%'
FROM duckdb_secrets() WHERE name = 'ssec_refresh';
----
true	true	false

# Without SSE_C_KEY, refresh_info stays visible as before
statement ok
CREATE SECRET plain_refresh (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    REGION 'us-east-1',
    REFRESH 'auto',
    SCOPE 's3://plain-refresh-bucket/'
);

query I
SELECT secret_string LIKE '%refresh_info=redacted%' FROM duckdb_secrets() WHERE name = 'plain_refresh';
----
false

# An invalid key fails at CREATE, without echoing the value
statement error
CREATE SECRET bad_key (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    SSE_C_KEY 'not-a-valid-key'
);
----
Invalid Input Error: SSE_C_KEY must be a valid base64-encoded 256-bit key

# 16 bytes is valid base64 but not a 256-bit key
statement error
CREATE SECRET short_key (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    SSE_C_KEY 'AAECAwQFBgcICQoLDA0ODw=='
);
----
Invalid Input Error: SSE_C_KEY must be a valid base64-encoded 256-bit key

# SSE_C_KEY is only registered for the s3 type, as on the httpfs config provider
statement error
CREATE SECRET gcs_ssec (
    TYPE GCS,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    SSE_C_KEY 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8='
);
----
Binder Error: Unknown parameter "sse_c_key" for secret type "gcs" with provider "credential_chain"

# KMS_KEY_ID is stored on the secret
statement ok
CREATE SECRET kms (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    REGION 'us-east-1',
    KMS_KEY_ID 'arn:aws:kms:us-east-1:123456789012:key/example',
    SCOPE 's3://kms-bucket/'
);

query I
SELECT secret_string LIKE '%kms_key_id=arn:aws:kms:us-east-1:123456789012:key/example%'
FROM duckdb_secrets() WHERE name = 'kms';
----
true

# httpfs rejects both options together when the secret is used, before any request is sent
statement ok
CREATE SECRET kms_and_ssec (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    KEY_ID 'AKIAEXAMPLE',
    SECRET 'example-secret',
    REGION 'us-east-1',
    KMS_KEY_ID 'arn:aws:kms:us-east-1:123456789012:key/example',
    SSE_C_KEY 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=',
    SCOPE 's3://both-bucket/'
);

statement error
COPY (SELECT 1 AS x) TO 's3://both-bucket/out.csv';
----
SSE_C_KEY and KMS_KEY_ID cannot be configured together

# --- Registration matrix: KMS_KEY_ID is accepted on every type the config provider accepts it on (all but rds) ---

statement ok
CREATE SECRET kms_aws (
    TYPE AWS,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    KMS_KEY_ID 'arn:aws:kms:us-east-1:123456789012:key/example'
);

statement ok
CREATE SECRET kms_r2 (
    TYPE R2,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    ACCOUNT_ID 'some-account',
    KMS_KEY_ID 'arn:aws:kms:us-east-1:123456789012:key/example',
    SCOPE 'r2://kms-r2-bucket/'
);

statement ok
CREATE SECRET kms_gcs (
    TYPE GCS,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    KMS_KEY_ID 'arn:aws:kms:us-east-1:123456789012:key/example',
    SCOPE 'gcs://kms-gcs-bucket/'
);

# RDS secrets expose no server-side encryption options, matching the config provider
statement error
CREATE SECRET kms_rds (
    TYPE RDS,
    PROVIDER credential_chain,
    KMS_KEY_ID 'arn:aws:kms:us-east-1:123456789012:key/example'
);
----
Binder Error: Unknown parameter "kms_key_id" for secret type "rds" with provider "credential_chain"

# --- Registration matrix: SSE_C_KEY is accepted only on the s3 type, like the config provider ---

statement error
CREATE SECRET ssec_r2 (
    TYPE R2,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    ACCOUNT_ID 'some-account',
    SSE_C_KEY 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8='
);
----
Binder Error: Unknown parameter "sse_c_key" for secret type "r2" with provider "credential_chain"

statement error
CREATE SECRET ssec_aws (
    TYPE AWS,
    PROVIDER credential_chain,
    CHAIN 'env',
    VALIDATION 'none',
    SSE_C_KEY 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8='
);
----
Binder Error: Unknown parameter "sse_c_key" for secret type "aws" with provider "credential_chain"
