# name: test/sql/aws_credential_chain_external_access.test
# description: The credential_chain provider reads files and makes requests through the AWS SDK, so it cannot be used when external access is disabled
# group: [sql]

require aws

require httpfs

# load the extensions and initialize the secret manager (and its persistent secret storage) while external access
# is still enabled - with external access disabled, neither extension autoloading nor the secret directory work
statement ok
LOAD aws;

statement ok
LOAD httpfs;

statement ok
FROM duckdb_secrets();

statement ok
SET enable_external_access=false;

statement error
CREATE SECRET s1 (TYPE S3, PROVIDER credential_chain);
----
<REGEX>:.*Permission Error.*credential_chain.*

statement error
CREATE SECRET s2 (TYPE S3, PROVIDER credential_chain, CHAIN 'web_identity', WEB_IDENTITY_TOKEN_FILE 'token');
----
<REGEX>:.*Permission Error.*credential_chain.*

# secrets with explicit credentials can still be created
statement ok
CREATE SECRET s3 (TYPE S3, PROVIDER config, KEY_ID 'key', SECRET 'secret', REGION 'us-east-1');
