# name: test/sql/aws_default_secret_persistent_none.test
# description: a persistent secret with PROVIDER none keeps S3 requests unsigned across restarts
# group: [sql]

require aws

require httpfs

load __TEST_DIR__/aws_default_secret_persistent_none.db

statement ok
SET secret_directory='{TEST_DIR}/aws_default_secret_persistent_none';

statement ok
CREATE PERSISTENT SECRET no_aws (TYPE s3, PROVIDER none);

restart

statement ok
SET secret_directory='{TEST_DIR}/aws_default_secret_persistent_none';

query II
SELECT name, storage FROM which_secret('s3://bucket/file.csv', 's3');
----
no_aws	local_file

query I
SELECT provider FROM duckdb_secrets() WHERE name = 'no_aws';
----
none

statement ok
DROP PERSISTENT SECRET no_aws;
