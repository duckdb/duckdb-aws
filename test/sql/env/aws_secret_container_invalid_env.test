# name: test/sql/env/aws_secret_container_invalid_env.test
# description: chain 'container' with a malformed container credentials URI fails, alone or in a longer chain (issue #230)
# group: [env]

require aws

require httpfs

# A relative URI must begin with '/', so the SDK rejects this one without any network call.
require-env AWS_CONTAINER_CREDENTIALS_RELATIVE_URI duckdb-invalid-relative-uri

statement ok
set secret_directory='{TEST_DIR}/aws_secret_container_invalid_env'

statement error
CREATE SECRET container_invalid_secret (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'container'
);
----
<REGEX>:.*Invalid Configuration Error: Chain value 'container' requires container credentials to be available.*

# only an absent container environment is skipped in a longer chain: a misconfigured one still fails
statement error
CREATE SECRET env_container_invalid_secret (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'env;container',
    VALIDATION 'none'
);
----
<REGEX>:.*Invalid Configuration Error: Chain value 'container' requires container credentials to be available.*
