# name: test/sql/env/aws_secret_profile_credentials_file.test
# description: profiles defined only in the shared credentials file must be found (issue #122)
# group: [env]

require aws

require httpfs

require-env AWS_CONFIG_FILE

require-env AWS_SHARED_CREDENTIALS_FILE

statement ok
set secret_directory='{TEST_DIR}/aws_secret_profile_credentials_file'

# A profile that exists only in the credentials file (the boto3/CLI default layout, where
# ~/.aws/config may not exist at all) must pass validation and resolve its static keys.
# Before the fix this failed with "no profile ... found in config file".
statement ok
CREATE SECRET creds_only (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'config',
    PROFILE 'minio-testing-credentials-only'
);

query I
SELECT secret_string FROM duckdb_secrets(redact=false) WHERE name='creds_only';
----
<REGEX>:.*key_id=minio_duckdb_user_creds_only.*

# The region also resolves from the credentials file when nothing else provides one.
# (The env-test CI step exports AWS_DEFAULT_REGION, which takes precedence over the
# profile; both outcomes are accepted so the exact profile region is only pinned when
# no ambient region is set, e.g. in the plain `make test` CI step.)
query I
SELECT secret_string FROM duckdb_secrets(redact=false) WHERE name='creds_only';
----
<REGEX>:.*region=(eu-west-3|duckdb_env_testing_region).*

# A profile present in both files merges with the config file winning on conflict:
# the region must come from the config file (eu-north-1), never the credentials file
# (us-fake-9), while the keys still come from the credentials file.
statement ok
CREATE SECRET both_files (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'config',
    PROFILE 'minio-testing-region-conflict'
);

query I
SELECT secret_string FROM duckdb_secrets(redact=false) WHERE name='both_files';
----
<REGEX>:.*key_id=minio_duckdb_user_conflict.*

query I
SELECT secret_string FROM duckdb_secrets(redact=false) WHERE name='both_files';
----
<REGEX>:.*region=(eu-north-1|duckdb_env_testing_region).*

# A profile found in neither file must name both searched files in the error.
statement error
CREATE SECRET missing_profile (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'config',
    PROFILE 'duckdb-no-such-profile-anywhere'
);
----
<REGEX>:.*no profile 'duckdb-no-such-profile-anywhere' found in config file .* or credentials file .*
