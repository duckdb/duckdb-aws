# name: test/sql/env/aws_secret_endpoints_env.test
# description: configured S3 endpoints use AWS precedence and the selected profile
# group: [env]

require aws

require httpfs

# Run with scripts/run_aws_endpoint_tests.py, which supplies isolated AWS files.
require-env DUCKDB_AWS_ENDPOINT_TESTS_AVAILABLE 1

require-env AWS_CONFIG_FILE

require-env AWS_SHARED_CREDENTIALS_FILE

require-env AWS_TEST_ENDPOINT_EXPECTED

require-env AWS_TEST_ENDPOINT_PROFILE_EXPECTED

# Do not allow the runner's default HTTP-error ignoring to hide failures.
set ignore_error_messages

statement ok
SET allow_persistent_secrets=false

statement ok
CREATE SECRET selected_profile (TYPE s3, PROVIDER credential_chain, CHAIN 'config');

query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) = '{AWS_TEST_ENDPOINT_EXPECTED}' FROM duckdb_secrets() WHERE name='selected_profile';
----
true

# PROFILE must override AWS_PROFILE / AWS_DEFAULT_PROFILE for endpoint lookup too.
statement ok
CREATE SECRET named_profile (TYPE s3, PROVIDER credential_chain, CHAIN 'config', PROFILE 'service');

query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) = '{AWS_TEST_ENDPOINT_PROFILE_EXPECTED}' FROM duckdb_secrets() WHERE name='named_profile';
----
true

# Endpoint configuration is independent of the credentials provider.
statement ok
CREATE SECRET env_credentials (TYPE s3, PROVIDER credential_chain, CHAIN 'env');

query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) = '{AWS_TEST_ENDPOINT_EXPECTED}' FROM duckdb_secrets() WHERE name='env_credentials';
----
true

# Also exercise the default credential chain, without an explicit CHAIN.
statement ok
CREATE SECRET default_chain (TYPE s3, PROVIDER credential_chain);

query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) = '{AWS_TEST_ENDPOINT_EXPECTED}' FROM duckdb_secrets() WHERE name='default_chain';
----
true

# Explicit SQL options win, even when configured endpoints are ignored.
statement ok
CREATE SECRET explicit_endpoint (TYPE s3, PROVIDER credential_chain, CHAIN 'config', ENDPOINT 'sql.example.com:9443', USE_SSL false, URL_STYLE 'path');

query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) FROM duckdb_secrets() WHERE name='explicit_endpoint';
----
sql.example.com:9443

query I
SELECT contains(secret_string, 'use_ssl=false') AND contains(secret_string, 'url_style=path') FROM duckdb_secrets() WHERE name='explicit_endpoint';
----
true

# Preserve existing semantics: an explicit empty endpoint selects the default.
statement ok
CREATE SECRET empty_endpoint (TYPE s3, PROVIDER credential_chain, CHAIN 'config', ENDPOINT '');

query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) FROM duckdb_secrets() WHERE name='empty_endpoint';
----
s3.amazonaws.com

# Refreshable secrets must receive the configured endpoint as well.
statement ok
CREATE SECRET refreshable (TYPE s3, PROVIDER credential_chain, CHAIN 'config', REFRESH 'auto');

query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) = '{AWS_TEST_ENDPOINT_EXPECTED}' FROM duckdb_secrets() WHERE name='refreshable';
----
true

# S3 endpoint configuration must not leak into other secret types.
statement ok
CREATE SECRET gcs_endpoint (TYPE gcs, PROVIDER credential_chain, CHAIN 'config');

query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) FROM duckdb_secrets() WHERE name='gcs_endpoint';
----
storage.googleapis.com

statement ok
CREATE SECRET r2_endpoint (TYPE r2, PROVIDER credential_chain, CHAIN 'config', ACCOUNT_ID 'test-account');

query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) FROM duckdb_secrets() WHERE name='r2_endpoint';
----
test-account.r2.cloudflarestorage.com

statement ok
CREATE SECRET aws_identity (TYPE aws, PROVIDER credential_chain, CHAIN 'config');

query I
SELECT contains(secret_string, 'endpoint=') FROM duckdb_secrets() WHERE name='aws_identity';
----
false
