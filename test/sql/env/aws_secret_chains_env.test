# name: test/sql/env/aws_secret_chains_env.test
# description: test aws extension with different chain configs
# group: [env]

require aws

require httpfs

require-env DUCKDB_AWS_TESTING_ENV_AVAILABLE

require-env AWS_ACCESS_KEY_ID

require-env AWS_SECRET_ACCESS_KEY

require-env AWS_DEFAULT_REGION

require-env AWS_CONFIG_FILE

require-env AWS_SHARED_CREDENTIALS_FILE

statement ok
set secret_directory='{TEST_DIR}/aws_secret_chains_env'

# Let's try explicitly passing in the config provider
statement ok
CREATE SECRET env_test (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'env'
);

query I
SELECT secret_string FROM duckdb_secrets(redact=false) where name='env_test';
----
<REGEX>:.*secret=duckdb_env_testing_key.*

query I
SELECT secret_string FROM duckdb_secrets(redact=false) where name='env_test';
----
<REGEX>:.*key_id=duckdb_env_testing_id.*

query I
SELECT secret_string FROM duckdb_secrets(redact=false) where name='env_test';
----
<REGEX>:.*region=duckdb_env_testing_region.*

statement ok
CREATE SECRET default_env_test (
    TYPE S3,
    PROVIDER credential_chain
);

query III
SELECT secret_string LIKE '%key_id=duckdb_env_testing_id%',
       secret_string LIKE '%secret=duckdb_env_testing_key%',
       secret_string LIKE '%region=duckdb_env_testing_region%'
FROM duckdb_secrets(redact=false) WHERE name='default_env_test';
----
true	true	true
