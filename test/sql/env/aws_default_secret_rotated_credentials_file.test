# name: test/sql/env/aws_default_secret_rotated_credentials_file.test
# description: the default secrets follow a rotated credentials file, once their expiry has passed and when a consumer refreshes them after an expired-token error
# group: [env]

require aws

require httpfs

# This test rewrites a credentials file, so it only writes to the one declared scratch:
#   export DUCKDB_AWS_SCRATCH_CREDENTIALS_FILE=/some/scratch/credentials
#   export AWS_SHARED_CREDENTIALS_FILE=$DUCKDB_AWS_SCRATCH_CREDENTIALS_FILE
# The default chain reads that file only when nothing earlier in the chain finds credentials, so
# AWS_ACCESS_KEY_ID must not be set; AWS_PROFILE would select another profile than [default].
require-env DUCKDB_AWS_SCRATCH_CREDENTIALS_FILE

require-env AWS_SHARED_CREDENTIALS_FILE

require-env-not AWS_ACCESS_KEY_ID

require-env-not AWS_PROFILE

require-env-not AWS_DEFAULT_PROFILE

query I
SELECT '{AWS_SHARED_CREDENTIALS_FILE}' = '{DUCKDB_AWS_SCRATCH_CREDENTIALS_FILE}';
----
true

# the aws_default storage is registered on load: under autoloading, 'require' alone does not load the extension
statement ok
LOAD aws;

statement ok
SET allow_persistent_secrets=false;

statement ok
COPY (SELECT line FROM (VALUES
    (1, '[default]'),
    (2, 'aws_access_key_id = AKIADUCKDBROTATION01'),
    (3, 'aws_secret_access_key = rotation01secretkey'),
    (4, 'region = us-east-1')) t(i, line) ORDER BY i)
TO '{DUCKDB_AWS_SCRATCH_CREDENTIALS_FILE}' (FORMAT csv, HEADER false, QUOTE '');

# the first lookup resolves the chain to the keys in the file
query I
SELECT name FROM which_secret('', 'aws');
----
__aws_default

query II
SELECT name, secret_string LIKE '%key_id=AKIADUCKDBROTATION01;%'
FROM duckdb_secrets() WHERE storage = 'aws_default' ORDER BY name;
----
__aws_default	true
__aws_default_s3	true

# both carry the refresh_info a consumer replays to rebuild the secret on an expired-token error: httpfs for the
# S3 one, Iceberg or Glue for the AWS one
query II
SELECT name, secret_string LIKE '%refresh_info=%'
FROM duckdb_secrets() WHERE storage = 'aws_default' ORDER BY name;
----
__aws_default	true
__aws_default_s3	true

# the keys in a file report no expiry; the snapshot of them is retaken after DEFAULT_CREDS_LOAD_FREQ_SECONDS (15 min)
query II
SELECT name, regexp_extract(secret_string, 'expiration_epoch_ms=([0-9]+)', 1)::BIGINT
       BETWEEN epoch_ms(now()) + 14 * 60 * 1000 AND epoch_ms(now()) + 15 * 60 * 1000
FROM duckdb_secrets() WHERE storage = 'aws_default' ORDER BY name;
----
__aws_default	true
__aws_default_s3	true

# the file is rotated
statement ok
COPY (SELECT line FROM (VALUES
    (1, '[default]'),
    (2, 'aws_access_key_id = AKIADUCKDBROTATION02'),
    (3, 'aws_secret_access_key = rotation02secretkey'),
    (4, 'region = us-east-1')) t(i, line) ORDER BY i)
TO '{DUCKDB_AWS_SCRATCH_CREDENTIALS_FILE}' (FORMAT csv, HEADER false, QUOTE '');

# until the expiry has passed, lookups keep the resolved credentials: the file is not read on every request
query I
SELECT name FROM which_secret('', 'aws');
----
__aws_default

query I
SELECT secret_string LIKE '%key_id=AKIADUCKDBROTATION01;%' FROM duckdb_secrets() WHERE name = '__aws_default';
----
true

# once it has passed (forced here: a test cannot wait 15 minutes), the next lookup resolves the chain again and
# finds the rotated keys
statement ok
SET debug_aws_default_credentials_expired = true;

query I
SELECT name FROM which_secret('', 'aws');
----
__aws_default

statement ok
RESET debug_aws_default_credentials_expired;

query II
SELECT name, secret_string LIKE '%key_id=AKIADUCKDBROTATION02;%'
FROM duckdb_secrets() WHERE storage = 'aws_default' ORDER BY name;
----
__aws_default	true
__aws_default_s3	true

# A consumer that gets an expired-token error before the expiry has passed rebuilds the secret it used from its
# refresh_info: the statement below is what httpfs (TryRefreshS3Secret) and Iceberg (SIGV4Authorization) replay,
# a replacement of the secret in its own storage with the options it was created with. Either default secret
# can be refreshed this way, and the refresh sets both.
statement ok
COPY (SELECT line FROM (VALUES
    (1, '[default]'),
    (2, 'aws_access_key_id = AKIADUCKDBROTATION03'),
    (3, 'aws_secret_access_key = rotation03secretkey'),
    (4, 'region = us-east-1')) t(i, line) ORDER BY i)
TO '{DUCKDB_AWS_SCRATCH_CREDENTIALS_FILE}' (FORMAT csv, HEADER false, QUOTE '');

statement ok
CREATE OR REPLACE SECRET __aws_default IN aws_default (TYPE aws, PROVIDER credential_chain, VALIDATION 'none', REFRESH 'auto');

query II
SELECT name, secret_string LIKE '%key_id=AKIADUCKDBROTATION03;%'
FROM duckdb_secrets() WHERE storage = 'aws_default' ORDER BY name;
----
__aws_default	true
__aws_default_s3	true

statement ok
COPY (SELECT line FROM (VALUES
    (1, '[default]'),
    (2, 'aws_access_key_id = AKIADUCKDBROTATION04'),
    (3, 'aws_secret_access_key = rotation04secretkey'),
    (4, 'region = us-east-1')) t(i, line) ORDER BY i)
TO '{DUCKDB_AWS_SCRATCH_CREDENTIALS_FILE}' (FORMAT csv, HEADER false, QUOTE '');

statement ok
CREATE OR REPLACE SECRET __aws_default_s3 IN aws_default (TYPE s3, PROVIDER credential_chain, VALIDATION 'none', REFRESH 'auto');

query II
SELECT name, secret_string LIKE '%key_id=AKIADUCKDBROTATION04;%'
FROM duckdb_secrets() WHERE storage = 'aws_default' ORDER BY name;
----
__aws_default	true
__aws_default_s3	true

# the refreshed pair can be refreshed again
query II
SELECT name, secret_string LIKE '%refresh_info=%'
FROM duckdb_secrets() WHERE storage = 'aws_default' ORDER BY name;
----
__aws_default	true
__aws_default_s3	true

# a refresh is the only way in: no other name, and not a secret of the other type under a default name
statement error
CREATE OR REPLACE SECRET other IN aws_default (TYPE aws, PROVIDER credential_chain, VALIDATION 'none');
----
Secrets cannot be created in the 'aws_default' secret storage

statement error
CREATE OR REPLACE SECRET __aws_default IN aws_default (TYPE s3, PROVIDER credential_chain, VALIDATION 'none');
----
Secrets cannot be created in the 'aws_default' secret storage
