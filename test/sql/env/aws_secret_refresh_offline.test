# name: test/sql/env/aws_secret_refresh_offline.test
# description: Offline, deterministic test that credential_chain secrets refresh expired credentials
# group: [env]

# Context:
# (duckdb-aws issues #26, #97, #64). Requires the local stub from
# scripts/refresh_test/start_stub.sh:
#
#     eval "$(scripts/refresh_test/start_stub.sh)"
#     build/release/test/unittest test/sql/env/aws_secret_refresh_offline.test
#
# Credentials come from a credential_process that mints a new key per invocation;
# the stub S3 server rejects revoked keys with the same 400 ExpiredToken document
# real S3 sends when temporary credentials (EC2/ECS/EKS roles, STS) expire.
# Revocation is driven from SQL by bumping min_valid.txt, so there are no clocks
# and no sleeps anywhere.

require aws

require httpfs

require-env AWS_REFRESH_STUB_ENDPOINT

require-env AWS_REFRESH_STUB_STATE

require-env AWS_CONFIG_FILE

require-env AWS_SHARED_CREDENTIALS_FILE

# By default the runner SKIPS a whole file when an unexpected error contains "HTTP" (assumed
# network flakiness). Every request here goes to the local stub, so an HTTP error is a real
# failure; clear the ignore list so a broken refresh fails the test instead of skipping it.
set ignore_error_messages __never_matched__

# The default lazy secrets would also run our credential_process; keep the counter
# deterministic by disabling them before anything resolves credentials.
statement ok
SET GLOBAL aws_default_credentials = false;

# A cached read would not hit the server, and this test is about what the server answers.
statement ok
SET enable_external_file_cache = false;

statement ok
SET enable_logging = true;

statement ok
SET logging_level = 'info';

# ---------------------------------------------------------------------------------------------
# Scenario 1: the issue itself. A credential_chain secret WITHOUT an explicit REFRESH option
# must refresh once its credentials expire. On unfixed code no refresh_info is stored (refresh
# was force-enabled only for the sts/web_identity chains), so the query below fails with the
# ExpiredToken error instead of refreshing.
# ---------------------------------------------------------------------------------------------

statement ok
CREATE SECRET refresh_default (
    TYPE s3,
    PROVIDER credential_chain,
    CHAIN 'process',
    REGION 'eu-west-1',
    ENDPOINT '{AWS_REFRESH_STUB_ENDPOINT}',
    USE_SSL false,
    URL_STYLE 'path'
);

query I
SELECT * FROM 's3://test-bucket/data.csv';
----
42

# Revoke every key issued so far: the server now answers 400 ExpiredToken for all of them.
statement ok
COPY (SELECT CAST(TRIM(content) AS INTEGER) + 1 FROM read_text('{AWS_REFRESH_STUB_STATE}/counter'))
TO '{AWS_REFRESH_STUB_STATE}/min_valid.txt' (FORMAT csv, HEADER false);

# Must succeed by re-running the credential process and retrying with the fresh key.
query I
SELECT * FROM 's3://test-bucket/data.csv';
----
42

query I
SELECT count(*) > 0 FROM duckdb_logs WHERE message LIKE '%Successfully refreshed secret: "refresh_default"%'
----
true

statement ok
DROP SECRET refresh_default;

# ---------------------------------------------------------------------------------------------
# Scenario 2: an explicit REFRESH 'none' opts out — expired credentials surface the error.
# ---------------------------------------------------------------------------------------------

statement ok
CREATE SECRET refresh_off (
    TYPE s3,
    PROVIDER credential_chain,
    CHAIN 'process',
    REFRESH 'none',
    REGION 'eu-west-1',
    ENDPOINT '{AWS_REFRESH_STUB_ENDPOINT}',
    USE_SSL false,
    URL_STYLE 'path'
);

query I
SELECT * FROM 's3://test-bucket/data2.csv';
----
42

statement ok
COPY (SELECT CAST(TRIM(content) AS INTEGER) + 1 FROM read_text('{AWS_REFRESH_STUB_STATE}/counter'))
TO '{AWS_REFRESH_STUB_STATE}/min_valid.txt' (FORMAT csv, HEADER false);

statement error
SELECT * FROM 's3://test-bucket/data2.csv';
----
400

statement ok
DROP SECRET refresh_off;

# ---------------------------------------------------------------------------------------------
# Scenario 3: expiration_epoch_ms sanity. The credential process emits an Expiration one hour
# out, so the stored expiry must be in (now, now + 2h]. A static-key secret has no real expiry:
# it must not carry the SDK's "never expires" sentinel (year 294247) — unfixed code stored it —
# but the DEFAULT_CREDS_LOAD_FREQ_SECONDS fallback, i.e. something within the next day.
# ---------------------------------------------------------------------------------------------

statement ok
CREATE SECRET refresh_expiry (
    TYPE s3,
    PROVIDER credential_chain,
    CHAIN 'process',
    REGION 'eu-west-1',
    ENDPOINT '{AWS_REFRESH_STUB_ENDPOINT}',
    USE_SSL false,
    URL_STYLE 'path'
);

query I
SELECT CAST(regexp_extract(secret_string, 'expiration_epoch_ms=(\d+)', 1) AS BIGINT)
           BETWEEN epoch_ms(now()) AND epoch_ms(now()) + 2 * 60 * 60 * 1000
FROM duckdb_secrets() WHERE name = 'refresh_expiry';
----
true

statement ok
CREATE SECRET refresh_static (
    TYPE s3,
    PROVIDER credential_chain,
    CHAIN 'config',
    PROFILE 'staticprof',
    REGION 'eu-west-1',
    ENDPOINT '{AWS_REFRESH_STUB_ENDPOINT}',
    USE_SSL false,
    URL_STYLE 'path'
);

query I
SELECT CAST(regexp_extract(secret_string, 'expiration_epoch_ms=(\d+)', 1) AS BIGINT)
           BETWEEN epoch_ms(now()) AND epoch_ms(now()) + 24 * 60 * 60 * 1000
FROM duckdb_secrets() WHERE name = 'refresh_static';
----
true

statement ok
DROP SECRET refresh_expiry;

statement ok
DROP SECRET refresh_static;
