# name: test/sql/env/aws_secret_endpoints_http.test
# description: httpfs uses the complete endpoint URL resolved from AWS config
# group: [env]

require aws

require httpfs

require-env DUCKDB_AWS_ENDPOINT_TESTS_AVAILABLE 1

require-env AWS_CONFIG_FILE

require-env AWS_SHARED_CREDENTIALS_FILE

require-env AWS_PROFILE local

require-env AWS_TEST_ENDPOINT_EXPECTED

# DuckDB's runner ignores HTTP errors by default. They must fail this test.
set ignore_error_messages

statement ok
SET allow_persistent_secrets=false

# The configured URL includes an HTTP scheme, port, base path and trailing slash.
# USE_SSL defaults to true, so this also verifies that the URL's scheme is honored.
statement ok
CREATE SECRET local_endpoint (TYPE s3, PROVIDER credential_chain, CHAIN 'config', URL_STYLE 'path');

# Fail before making any request if endpoint resolution regresses.
query I
SELECT regexp_extract(secret_string, 'endpoint=([^;]*)', 1) = '{AWS_TEST_ENDPOINT_EXPECTED}' FROM duckdb_secrets() WHERE name='local_endpoint';
----
true

query I
SELECT value FROM read_csv('s3://test-bucket/endpoint.csv');
----
42
