# name: test/sql/s3/s3_functions_aws.test
# description: the s3_* bucket functions against a provisioned S3 fixture, plus one bucket they create and delete
# group: [s3]

# Needs the fixture environment: `source test/sql/s3/s3.env` (generated by scripts/s3/create_bucket.sh
# on the s3tables-test-fixtures branch). It exports the fixture bucket and temporary credentials for
# the selected AWS profile. The test creates `{AWS_S3_BUCKET}-fn` and deletes it again; if a run dies
# in between, remove it by hand before the next run:
#   FROM s3_delete_bucket('<AWS_S3_BUCKET>-fn', cascade := true);
# S3 can refuse to re-create a just-deleted name for a while (OperationAborted); wait and rerun.
# Bucket configuration reads are eventually consistent, so a tag or versioning check right after a
# write can occasionally see the old value; rerun.

require-env S3_TEST_AVAILABLE 1

require-env AWS_S3_BUCKET

require-env AWS_REGION

require-env AWS_ACCESS_KEY_ID

require-env AWS_SECRET_ACCESS_KEY

require aws

require httpfs

require parquet

statement ok
SET allow_persistent_secrets=false

# One s3 secret serves both the s3_* functions (FindAwsSecret accepts type s3) and the s3:// write below.
statement ok
CREATE TEMPORARY SECRET s3_fixture_credentials (
    TYPE s3,
    PROVIDER credential_chain,
    CHAIN 'env',
    REGION '{AWS_REGION}'
);

#===--------------------------------------------------------------------===#
# The provisioned fixture bucket, read only
#===--------------------------------------------------------------------===#

query I
SELECT count(*) FROM s3_buckets() WHERE name = '{AWS_S3_BUCKET}';
----
1

# An explicit region filters server-side and still finds the bucket in its own region.
query II
SELECT name, region FROM s3_buckets(region := '{AWS_REGION}') WHERE name = '{AWS_S3_BUCKET}';
----
{AWS_S3_BUCKET}	{AWS_REGION}

query III
SELECT name, region, arn FROM s3_get_bucket('{AWS_S3_BUCKET}');
----
{AWS_S3_BUCKET}	{AWS_REGION}	arn:aws:s3:::{AWS_S3_BUCKET}

# A wrong starting region is corrected from S3's answer, so the handle region is only a hint.
query I
SELECT region FROM s3_get_bucket('{AWS_S3_BUCKET}', region := 'ap-southeast-2');
----
{AWS_REGION}

query I
SELECT region FROM s3_get_bucket(MAP {'name': '{AWS_S3_BUCKET}', 'region': 'ap-southeast-2'});
----
{AWS_REGION}

# scripts/s3/create_bucket.sh tags the fixture with Project = duckdb-aws.
query I
SELECT value FROM s3_bucket_tags('{AWS_S3_BUCKET}') WHERE key = 'Project';
----
duckdb-aws

statement error
SELECT * FROM s3_get_bucket('{AWS_S3_BUCKET}-nope');
----
NoSuchBucket

#===--------------------------------------------------------------------===#
# Lifecycle of a bucket this test owns
#===--------------------------------------------------------------------===#

# dry_run stops before the mutation: no bucket exists, so handle and ARN stay NULL.
query IIII
SELECT handle, arn, name, region
FROM s3_create_bucket('{AWS_S3_BUCKET}-fn', region := '{AWS_REGION}', dry_run := true);
----
NULL	NULL	{AWS_S3_BUCKET}-fn	{AWS_REGION}

query III
SELECT handle, name, arn
FROM s3_create_bucket('{AWS_S3_BUCKET}-fn', region := '{AWS_REGION}', versioning := true, tags := MAP {'team': 'data'});
----
{name={AWS_S3_BUCKET}-fn, region={AWS_REGION}}	{AWS_S3_BUCKET}-fn	arn:aws:s3:::{AWS_S3_BUCKET}-fn

# Creating a name the account already owns fails in every region, including us-east-1 (probed).
statement error
SELECT * FROM s3_create_bucket('{AWS_S3_BUCKET}-fn', region := '{AWS_REGION}');
----
<REGEX>:.*(BucketAlreadyOwnedByYou|already exists).*

query II
SELECT region, versioning FROM s3_get_bucket('{AWS_S3_BUCKET}-fn');
----
{AWS_REGION}	Enabled

# Provenance tags are added to the caller's.
query I
SELECT list_sort(list(key)) FROM s3_bucket_tags('{AWS_S3_BUCKET}-fn');
----
[created-by, duckdb-version, team]

query II
SELECT key, value FROM s3_bucket_tags('{AWS_S3_BUCKET}-fn') WHERE key IN ('created-by', 'team') ORDER BY key;
----
created-by	duckdb
team	data

# dry_run reports the merged result and writes nothing.
query IIII
SELECT status, tags['team'], map_contains(tags, 'created-by'), versioning
FROM s3_update_bucket('{AWS_S3_BUCKET}-fn', tags := MAP {'team': 'platform'}, versioning := false, dry_run := true);
----
dry_run	platform	true	Suspended

query II
SELECT (SELECT value FROM s3_bucket_tags('{AWS_S3_BUCKET}-fn') WHERE key = 'team'),
       (SELECT versioning FROM s3_get_bucket('{AWS_S3_BUCKET}-fn'));
----
data	Enabled

# Tags merge: one call adds a key, the next changes one and removes another with a NULL value.
query I
SELECT tags['owner'] FROM s3_update_bucket('{AWS_S3_BUCKET}-fn', tags := MAP {'owner': 'tests'});
----
tests

query IIIII
SELECT status, tags['team'], map_contains(tags, 'owner'), versioning, block_public_access
FROM s3_update_bucket('{AWS_S3_BUCKET}-fn', tags := MAP {'team': 'platform', 'owner': NULL},
                      versioning := false, block_public_access := true);
----
updated	platform	false	Suspended	true

query II
SELECT versioning, block_public_access FROM s3_get_bucket('{AWS_S3_BUCKET}-fn');
----
Suspended	true

query II
SELECT key, value FROM s3_bucket_tags('{AWS_S3_BUCKET}-fn') WHERE key IN ('team', 'owner') ORDER BY key;
----
team	platform

# Untouched settings come back NULL.
query III
SELECT tags IS NULL, versioning, block_public_access IS NULL
FROM s3_update_bucket('{AWS_S3_BUCKET}-fn', versioning := true);
----
true	Enabled	true

# A non-empty bucket: plain delete fails, dry_run counts, cascade empties and deletes.
statement ok
COPY (SELECT 1 AS i) TO 's3://{AWS_S3_BUCKET}-fn/duckdb-fixture/one.parquet';

statement error
SELECT * FROM s3_delete_bucket('{AWS_S3_BUCKET}-fn');
----
BucketNotEmpty

query III
SELECT status, deleted_objects, warning IS NOT NULL
FROM s3_delete_bucket('{AWS_S3_BUCKET}-fn', dry_run := true);
----
dry_run	1	true

query III
SELECT status, deleted_objects, warning
FROM s3_delete_bucket('{AWS_S3_BUCKET}-fn', cascade := true, dry_run := true);
----
dry_run	1	NULL

query III
SELECT status, deleted_objects, warning
FROM s3_delete_bucket(MAP {'name': '{AWS_S3_BUCKET}-fn', 'region': '{AWS_REGION}'}, cascade := true);
----
deleted	1	NULL

statement ok
DROP SECRET s3_fixture_credentials
