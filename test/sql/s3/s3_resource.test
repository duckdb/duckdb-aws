# name: test/sql/s3/s3_resource.test
# description: the aws:s3:bucket external-resource type and its callbacks
# group: [s3]

require no_extension_autoloading "EXPECTED: Test relies on explicit INSTALL and LOAD"

require httpfs

require aws

# Every AWS call below is meant to fail. Pin the identity to the AWS documentation's example key
# pair, which never resolves to a real identity, so this holds even where the environment carries
# real credentials: the provisioning statement further down would otherwise create a real bucket.
statement ok
CREATE SECRET example_credentials (TYPE aws, KEY_ID 'AKIAIOSFODNN7EXAMPLE', SECRET 'wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY', REGION 'eu-central-1');

# The type is registered from C++ (origin 'extension'), so LOAD aws is all a user needs. Its kind
# is 'storage': a bucket is listed and destroyed, not attached.
query IIIIII
SELECT name, kind, origin, create_function, status_function, list_function
FROM duckdb_external_resource_types() WHERE name = 'aws:s3:bucket';
----
aws:s3:bucket	storage	extension	__aws__s3__bucket__create	__aws__s3__bucket__status	__aws__s3__bucket__list

query I
SELECT destroy_function FROM duckdb_external_resource_types() WHERE name = 'aws:s3:bucket';
----
__aws__s3__bucket__destroy

# The handle is `name` plus `region`; one without a name is refused before any AWS call.
statement error
SELECT * FROM __aws__s3__bucket__status(MAP {'region': 'eu-central-1'});
----
handle is missing 'name'

statement error
SELECT * FROM __aws__s3__bucket__destroy(MAP {'region': 'eu-central-1'});
----
handle is missing 'name'

# Provisioning through the framework reaches the create callback and, from there, the AWS call,
# which the example key fails: the error names the callback rather than anything earlier in the chain.
statement error
CREATE EXTERNAL RESOURCE 'aws:s3:bucket' AS bucket_x (REGION 'eu-central-1');
----
<REGEX>:.*__aws__s3__bucket__create.*

# Adoption of an existing bucket goes through status, not create.
statement error
REGISTER EXTERNAL RESOURCE 'aws:s3:bucket' AS bucket_y
FROM MAP {'name': 'duckdb-no-such-bucket-0000', 'region': 'eu-central-1'};
----
<REGEX>:.*__aws__s3__bucket__status.*

# Persistent substitutes are visible to the adapters' internal connections. The delete errors on
# cascade=true even for an empty bucket, so a teardown that cascades cannot pass by luck; the tags
# substitute reports a matching tag, so a teardown that cascades on the tag errors the same way.
statement ok
CREATE TABLE bucket_contents (name VARCHAR);
INSERT INTO bucket_contents VALUES ('owned'), ('adopted');

statement ok
CREATE MACRO s3_create_bucket(bucket_name, region := NULL, tags := NULL) AS TABLE
SELECT MAP {'name': bucket_name, 'region': region} AS handle;

statement ok
CREATE MACRO s3_get_bucket(handle) AS TABLE
SELECT handle['name'] AS name, 'arn:aws:s3:::' || handle['name'] AS arn, handle['region'] AS region;

statement ok
CREATE MACRO s3_bucket_tags(handle) AS TABLE
SELECT 'duckdb-external-resource-type' AS key, 'aws:s3:bucket' AS value;

statement ok
CREATE MACRO s3_delete_bucket(handle, cascade := false) AS TABLE
SELECT CASE
    WHEN cascade THEN error('implicit cascade requested')
    WHEN EXISTS (SELECT 1 FROM bucket_contents WHERE name = handle['name']) THEN error('BucketNotEmpty')
    ELSE 'deleted'
END AS status;

statement ok
CREATE EXTERNAL RESOURCE 'aws:s3:bucket' AS owned (NAME 'owned', REGION 'eu-central-1');

statement ok
REGISTER EXTERNAL RESOURCE 'aws:s3:bucket' AS adopted
FROM MAP {'name': 'adopted', 'region': 'eu-central-1'};

statement error
DESTROY EXTERNAL RESOURCE owned;
----
BucketNotEmpty

statement error
DESTROY EXTERNAL RESOURCE adopted;
----
BucketNotEmpty

query I
SELECT count(*) FROM duckdb_external_resources() WHERE name IN ('owned', 'adopted');
----
2

statement ok
REGISTER EXTERNAL RESOURCE 'aws:s3:bucket' AS empty_adopted
FROM MAP {'name': 'empty', 'region': 'eu-central-1'};

statement ok
DESTROY EXTERNAL RESOURCE empty_adopted;

query I
SELECT count(*) FROM duckdb_external_resources() WHERE name = 'empty_adopted';
----
0

statement ok
DELETE FROM bucket_contents;

statement ok
DESTROY EXTERNAL RESOURCE owned;

statement ok
DESTROY EXTERNAL RESOURCE adopted;

query I
SELECT count(*) FROM duckdb_external_resources() WHERE name IN ('owned', 'adopted');
----
0
