# name: test/sql/storage/arn.test
# group: [storage]

require httpfs

require aws

statement ok
LOAD aws

# Even with 'TYPE arn', the path has to be correct
statement error
ATTACH 'aws:s3tables:eu-central-1:840140254803:bucket/duckdb-s3tables-test' as db (
	TYPE arn
);
----
Invalid Input Error: Expected an AWS ARN of the form 'arn:<partition>:<service>:<region>:<account>:<resource>', got 'aws:s3tables:eu-central-1:840140254803:bucket/duckdb-s3tables-test'

statement error
ATTACH '' as db (
	TYPE arn
);
----
Invalid Input Error: Expected an AWS ARN of the form 'arn:<partition>:<service>:<region>:<account>:<resource>', got ''

statement error
ATTACH 'arn::s3tables:::' as db;
----
Invalid Input Error: Invalid PARTITION Section of ARN: ''

statement error
ATTACH 'arn:aws::::' as db;
----
Not implemented Error: ATTACH of AWS ARN service '' is not supported. Supported options are: rds, redshift, redshift-serverless, s3tables

# RDS dispatch only accepts DB instance ARNs, and the ARN owns its region.
statement error
ATTACH 'arn:aws:rds:eu-central-1:840140254803:cluster:not-an-instance' AS db;
----
Invalid Input Error: Expected an RDS DB instance ARN with a resource of the form 'db:<instance-id>', got 'arn:aws:rds:eu-central-1:840140254803:cluster:not-an-instance'

statement error
ATTACH 'arn:aws:rds:eu-central-1:840140254803:db:instance' AS db (REGION 'us-east-1');
----
Invalid Input Error: ATTACH option 'region' is derived from the ARN and cannot be set explicitly

# A redshift ARN goes to the redshift extension from aws.amazon.com, which is not installed here: the error says how
statement error
ATTACH 'arn:aws:redshift:eu-central-1:840140254803:namespace:e542f89f-b604-4110-a337-f7ba8c7ce156' AS db;
----
<REGEX>:Missing Extension Error.*requires the 'redshift' extension from aws.amazon.com.*INSTALL redshift FROM aws.amazon.com.*TYPE redshift_postgres.*

statement error
ATTACH 'arn:aws:redshift-serverless:eu-central-1:840140254803:workgroup/wg' AS db;
----
<REGEX>:Missing Extension Error.*requires the 'redshift' extension from aws.amazon.com.*

# Naming the type is the same as the default
statement error
ATTACH 'arn:aws:redshift:eu-central-1:840140254803:namespace:e542f89f-b604-4110-a337-f7ba8c7ce156' AS db (TYPE redshift);
----
<REGEX>:Missing Extension Error.*requires the 'redshift' extension from aws.amazon.com.*

# TYPE redshift_postgres is this extension's own attach; it reads region, account and resource off the ARN itself,
# and only accepts namespace ARNs with a region and account ID.
statement error
ATTACH 'arn:aws:redshift:eu-central-1:840140254803:cluster:not-a-namespace' AS db (TYPE redshift_postgres);
----
Invalid Input Error: Expected a Redshift namespace ARN with a resource of the form 'namespace:<namespace-id>', got 'arn:aws:redshift:eu-central-1:840140254803:cluster:not-a-namespace'

statement error
ATTACH 'arn:aws:redshift:eu-central-1::namespace:e542f89f-b604-4110-a337-f7ba8c7ce156' AS db (TYPE redshift_postgres);
----
Invalid Input Error: Redshift namespace ARN 'arn:aws:redshift:eu-central-1::namespace:e542f89f-b604-4110-a337-f7ba8c7ce156' does not specify an account ID

statement error
ATTACH 'arn:aws:redshift:eu-central-1:840140254803:namespace:e542f89f-b604-4110-a337-f7ba8c7ce156' AS db (TYPE redshift_postgres, REGION 'us-east-1');
----
Invalid Input Error: ATTACH option 'region' is derived from the ARN and cannot be set explicitly

statement error
ATTACH 'arn:aws:redshift:eu-central-1:840140254803:namespace:e542f89f-b604-4110-a337-f7ba8c7ce156' AS db (TYPE redshift_postgres, ACCOUNT_ID '123456789012');
----
Invalid Input Error: Redshift ARN options cannot be set directly

statement error
ATTACH 'arn:aws:rds:eu-central-1:840140254803:db:instance' AS db (TYPE redshift_postgres);
----
Invalid Input Error: Expected a Redshift ARN (service 'redshift' or 'redshift-serverless'), got 'arn:aws:rds:eu-central-1:840140254803:db:instance'

# The same shape checks through TYPE rds
statement error
ATTACH 'arn:aws:redshift:eu-central-1:840140254803:namespace:x' AS db (TYPE rds);
----
Invalid Input Error: Expected an RDS DB instance ARN with a resource of the form 'db:<instance-id>', got 'arn:aws:redshift:eu-central-1:840140254803:namespace:x'

statement error
ATTACH 'arn:aws:rds::840140254803:db:instance' AS db (TYPE rds);
----
Invalid Input Error: RDS DB instance ARN 'arn:aws:rds::840140254803:db:instance' does not specify a region
