# name: test/sql/aws_default_secret_external_access.test
# description: the implicit default S3 secret is not resolved when external access is disabled
# group: [sql]

require aws

require httpfs

statement ok
SET allow_persistent_secrets=false;

# the credential chain reads files and the environment outside of the file systems of DuckDB
statement ok
SET enable_external_access=false;

query I
SELECT count(*) FROM which_secret('s3://bucket/file.csv', 's3');
----
0

query I
SELECT count(*) FROM which_secret('', 'aws');
----
0

query II
SELECT name, provider FROM duckdb_secrets() WHERE storage = 'aws_default' ORDER BY name;
----
__aws_default	lazy
__aws_default_s3	lazy
