# name: test/sql/aws_default_secret_identity.test
# description: RDS and Redshift prefer an explicit AWS secret over the default ones, and fall back to them
# group: [sql]

require aws

require httpfs

statement ok
SET allow_persistent_secrets=false;

# a single explicit secret is used, the default secrets do not make it ambiguous
statement ok
CREATE SECRET explicit (TYPE aws, PROVIDER none);

statement error
ATTACH 'mydb' AS rds_db (TYPE rds, REGION 'us-east-1');
----
Secret "explicit" holds no AWS credentials

statement ok
DROP SECRET explicit;

# without an explicit secret, and with the default ones switched off, there are no credentials
statement ok
SET aws_default_credentials=false;

statement error
ATTACH 'mydb' AS rds_db (TYPE rds, REGION 'us-east-1');
----
No AWS credentials found

# naming a default secret resolves it; switched off, it holds no credentials
statement error
ATTACH 'mydb' AS rds_db (TYPE rds, REGION 'us-east-1', SECRET __aws_default);
----
No AWS credentials found: the default credential chain found none
